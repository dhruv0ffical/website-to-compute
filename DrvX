const renderTabContent = () => { switch (activeTab) { case 'home': return ( <div> <h2>Home Feed</h2> {videos.map(video => ( <div key={video.id} style={{border:'1px solid #ff0000', margin:'10px', padding:'10px', borderRadius:'10px', backgroundColor:'#111'}}> <h3 style={{color:'#ff0000'}}>{video.title}</h3> <p style={{color:'#fff'}}>Creator: {video.creator}</p> <p style={{color:'#fff'}}>Views: {video.views} | Likes: {video.likes}</p> <p style={{color:'#0f0'}}>Creator Earned: ₹{video.earned} | Viewer Earned: ₹{video.viewerEarned}</p> </div> ))} </div> ); case 'videos': return <h2 style={{color:'#fff'}}>All Videos</h2>; case 'creator': return ( <div> <h2 style={{color:'#ff

